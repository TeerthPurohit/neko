# Neko Android app defaults to this API endpoint when built.
NEKO_BACKEND_URL=https://neko-teerth.fly.dev

# Neon production branch. Use its pooled Postgres connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
NEON_BRANCH=production

# Generate unique random values locally. Do not commit this file's real values.
NEKO_PAIRING_SECRET=replace-with-a-random-secret-at-least-32-characters
MODEL_KEY_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-key
AGENT_SERVICE_TOKEN=replace-with-a-random-secret-at-least-32-characters

# Local development uses the loopback agent service; Fly sets this in fly.toml.
AGENT_SERVICE_URL=http://127.0.0.1:8081
CHAT_MODELS=xiaomi/mimo-v2.6-pro
CLASSIFIER_MODEL=typesafe/jev-1.13
ALLOW_PAID_AI=true
MONTHLY_AI_BUDGET_USD=2
DAILY_AI_REQUESTS=100

# Optional: required only for server-originated FCM push notifications.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# OpenRouter keys are entered per user in the app and encrypted in Neon.
